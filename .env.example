# Atlas Demo Environment Variables (.env.example)

NODE_ENV=development
PORT=3000

# Auth JWT Secret (minimum 32 characters)
SESSION_SECRET=atlas_demo_super_secret_jwt_key_at_least_32_chars_long!

# Optional Gemini API Key (if omitted, AI coach runs in scripted fallback mode)
GEMINI_API_KEY=

# Local Data Persistence Directory
DATABASE_DIR=./data/postgres
